# Copie para .env.local (raiz do repositório) e preencha. Nunca commite valores reais.
# Um único arquivo, lido pelo web (via next.config.ts), pelo worker e pelos scripts.
# Painel do Supabase: https://supabase.com/dashboard/project/<ref>

# Ref do projeto chavi-dev. Painel: Project Settings > General > Project ID.
# Seed e testes de RLS recusam rodar contra qualquer outro ref (ADR-010).
SUPABASE_DEV_PROJECT_REF=

# URL da API. Painel: Project Settings > API Keys (ou botão Connect) > Project URL.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable (sb_publishable_...), segura para o browser. Painel: Project Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secret (sb_secret_...), ignora RLS. Só worker, scripts e os módulos server-only de convite
# e de ingestão de webhook (ADR-007). Nunca no browser.
# Painel: Project Settings > API Keys > Secret keys > criar/revelar.
SUPABASE_SECRET_KEY=

# Conexão do worker/pg-boss: session pooler, porta 5432 (NUNCA 6543).
# Painel: botão Connect > Session pooler > URI (troque [YOUR-PASSWORD] pela senha do banco).
DATABASE_URL_DIRECT=

# Opcional: intervalo (ms) do relay da outbox no worker. Padrão 2000.
# OUTBOX_POLL_MS=2000

# Senha dos usuários de teste criados por `pnpm db:seed` (12+ caracteres). Você escolhe; não
# vem do painel. Só para o chavi-dev; nunca use em produção.
SEED_USER_PASSWORD=

# --- Marco Demo (ADR-017 a ADR-019) ---

# OpenAI: chave em platform.openai.com > API keys. Modelo: nome exato da sua conta, com suporte
# a Structured Outputs. Só o worker usa.
OPENAI_API_KEY=
OPENAI_MODEL=

# Evolution API (mesma VPS). URL pela rede interna do Docker, ex.: http://evolution-api:8080
# (fora da VPS, use a URL pública com HTTPS). Chave: AUTHENTICATION_API_KEY da Evolution ou a
# apikey da instância. Instância: nome da instância Baileys do número de teste.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Segredo que a Evolution envia no header x-chavi-webhook-secret. Você gera (ex.:
# `openssl rand -hex 32`); no banco fica só o hash. Usado por `pnpm demo:setup-whatsapp`.
EVOLUTION_WEBHOOK_SECRET=

# Domínio público do site na VPS (DNS tipo A na Hostinger apontando para o IP da VPS).
# Ex.: app.seudominio.com.br
APP_DOMAIN=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
