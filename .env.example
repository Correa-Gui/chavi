# Copie para .env.local (raiz do repositório) e preencha. Nunca commite valores reais.
# Um único arquivo, lido pelo web (via next.config.ts), pelo worker e pelos scripts.
# Painel do Supabase: https://supabase.com/dashboard/project/<ref>

# Ref do projeto chavi-dev. Painel: Project Settings > General > Project ID.
# Seed e testes de RLS recusam rodar contra qualquer outro ref (ADR-010).
SUPABASE_DEV_PROJECT_REF=

# URL da API. Painel: Project Settings > API Keys (ou botão Connect) > Project URL.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable (sb_publishable_...), segura para o browser. Painel: Project Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secret (sb_secret_...), ignora RLS. Só worker, scripts e o módulo de convite. Nunca no browser.
# Painel: Project Settings > API Keys > Secret keys > criar/revelar.
SUPABASE_SECRET_KEY=

# Conexão do worker/pg-boss: session pooler, porta 5432 (NUNCA 6543).
# Painel: botão Connect > Session pooler > URI (troque [YOUR-PASSWORD] pela senha do banco).
DATABASE_URL_DIRECT=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
